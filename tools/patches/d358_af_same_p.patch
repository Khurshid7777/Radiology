+++ b/tests/test_atrial_map_d358.py
@@ -0,0 +1,59 @@
+"""D358: the same conducted P before most QRS withdraws a false AF; off by default until its acceptance."""
+
+import numpy as np
+import pytest
+
+import cardiolens.pipeline as P
+from cardiolens.contracts.findings import Finding, FindingSet
+from cardiolens.layer1_ingestion import generate_synthetic_ecg
+from cardiolens.layer3_measure.atrial_map import LEADS, conducted_p
+
+
+@pytest.fixture(scope="module")
+def sinus():
+    sig = generate_synthetic_ecg(heart_rate_bpm=70, seed=3)
+    res = P.run_pipeline(sig, mode="A")
+    return sig, res.measurements
+
+
+def _leads(sig):
+    return {ln: np.asarray(sig.lead(ln), float) for ln in LEADS if ln in sig.lead_names}
+
+
+def test_sinus_has_the_same_p_before_every_qrs(sinus):
+    sig, m = sinus
+    f = conducted_p(_leads(sig), m.r_peaks_samples, sig.sampling_rate_hz)
+    if f is None or f["n_p"] == 0:
+        pytest.skip("P detector model not available")
+    assert f["share"] >= 0.9 and f["pr_iqr_s"] <= 0.02 and f["shape_ii"] >= 0.9
+
+
+def test_too_few_beats_gives_nothing(sinus):
+    sig, m = sinus
+    assert conducted_p(_leads(sig), m.r_peaks_samples[:3], sig.sampling_rate_hz) is None
+
+
+def _af_set():
+    return FindingSet(findings=[Finding(code="atrial_fibrillation", group="rhythm", label_ru="ФП", label_uz="BF", confidence=0.8)])
+
+
+def test_off_by_default_keeps_af(sinus):
+    sig, m = sinus
+    assert P.AF_SAME_P_WITHDRAW is False
+    fs, audit = _af_set(), []
+    P._withdraw_af_on_same_p(sig, m, fs, audit)
+    assert "atrial_fibrillation" in fs.codes() and not audit
+
+
+def test_on_withdraws_af_and_says_why(sinus, monkeypatch):
+    sig, m = sinus
+    f = conducted_p(_leads(sig), m.r_peaks_samples, sig.sampling_rate_hz)
+    if f is None or f["n_p"] == 0:
+        pytest.skip("P detector model not available")
+    monkeypatch.setattr(P, "AF_SAME_P_WITHDRAW", True)
+    fs, audit = _af_set(), []
+    P._withdraw_af_on_same_p(sig, m, fs, audit)
+    assert "atrial_fibrillation" not in fs.codes()
+    irr = fs.by_code("irregular_rhythm")
+    assert irr is not None and "ФП не подтверждается" in irr.label_ru and "D358" in audit[-1]
+    assert not any("а" <= ch <= "я" for ch in irr.label_uz.lower())
diff --git a/tools/atrial_map/af_same_p_bench.py b/tools/atrial_map/af_same_p_bench.py
new file mode 100644
index 0000000..a43dd38
--- /dev/null
+++ b/tools/atrial_map/af_same_p_bench.py
@@ -0,0 +1,73 @@
+"""D358 acceptance: AF withdrawn on the same conducted P (pipeline.AF_SAME_P_WITHDRAW) — off vs on.
+
+Each record runs through the site pipeline with the flag off; only where AF / possible AF is named does it run again
+with the flag on (the rule does nothing elsewhere). One JSON line per record (labels, codes off/on, alerts off/on) —
+numbers and codes only, no signal; the output stays in the given folder (git-ignored data, never committed).
+
+    python tools/atrial_map/af_same_p_bench.py SET K N OUT_DIR
+SET: rhythm_odd | fresh | fresh2 | afl (Chapman svt_bench AFL)."""
+from __future__ import annotations
+
+import json
+import sys
+import warnings
+from pathlib import Path
+
+warnings.filterwarnings("ignore")
+ROOT = Path(__file__).resolve().parents[2]
+sys.path.insert(0, str(ROOT / "src"))
+
+import cardiolens.pipeline as P
+from cardiolens.layer1_ingestion import load_wfdb
+
+AF = {"atrial_fibrillation", "possible_atrial_fibrillation"}
+
+
+def items(name: str):
+    if name in ("rhythm_odd", "fresh", "fresh2"):
+        d = {"rhythm_odd": "ptbxl_rhythm", "fresh": "ptbxl_fresh", "fresh2": "ptbxl_fresh2"}[name]
+        for r in json.loads((ROOT / "data" / d / "manifest.json").read_text())["records"]:
+            if name == "rhythm_odd" and int(r["ecg_id"]) % 2 == 0:
+                continue
+            yield str(r["ecg_id"]), r["labels"], ROOT / "data" / d / r["filename_hr"], r.get("age")
+    elif name == "afl":
+        for r in json.loads((ROOT / "data/svt_bench/manifest.json").read_text())["records"]:
+            if "AFL" in r["labels"]:
+                yield r["name"], r["labels"], ROOT / "data/svt_bench" / r["folder"] / r["name"], r.get("age")
+    else:
+        raise SystemExit(f"unknown set {name}")
+
+
+def run(path: Path, age, flag: bool):
+    P.AF_SAME_P_WITHDRAW = flag
+    sig = load_wfdb(str(path))
+    try:
+        sig.patient.age_years = float(age) if age not in (None, "") else None
+    except ValueError:
+        pass
+    res = P.run_pipeline(sig, mode="A")
+    return sorted(res.findings.codes()), sorted({a.code for a in res.safety.alerts})
+
+
+def main() -> None:
+    name, k, n, out_dir = sys.argv[1], int(sys.argv[2]), int(sys.argv[3]), Path(sys.argv[4])
+    out_dir.mkdir(parents=True, exist_ok=True)
+    out = out_dir / f"{name}_{k}of{n}.jsonl"
+    done = {json.loads(line)["id"] for line in out.open()} if out.exists() else set()
+    with out.open("a") as fh:
+        for i, (rid, labels, path, age) in enumerate(items(name)):
+            if i % n != k or rid in done:
+                continue
+            row = {"id": rid, "labels": labels}
+            try:
+                off = run(path, age, False)
+                on = run(path, age, True) if AF & set(off[0]) else off
+                row.update(codes_off=off[0], alerts_off=off[1], codes_on=on[0], alerts_on=on[1])
+            except Exception as ex:  # a record that fails is counted, not fatal
+                row["error"] = f"{type(ex).__name__}: {str(ex)[:80]}"
+            fh.write(json.dumps(row) + "\n")
+            fh.flush()
+
+
+if __name__ == "__main__":
+    main()
