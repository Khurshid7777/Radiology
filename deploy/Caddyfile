# HTTPS for the CardioLens site: Caddy gets a Let's Encrypt certificate for {$DOMAIN}
# (the domain's A record must point at this server, ports 80 and 443 open).
{$DOMAIN} {
	encode gzip
	# 4 photos x 25 MB on /scans (SD-066) plus form fields.
	request_body {
		max_size 110MB
	}
	reverse_proxy cardiolens:8000
}

# D341 (owner, 21.11): the bare domain points here too (A record 149.202.70.147) but had no certificate, so browsers
# got ERR_SSL_PROTOCOL_ERROR. Caddy gets its own certificate and sends visitors on to the site. www.vision-ai.uz is not
# listed until its DNS record exists (a name without DNS makes Caddy retry the certificate forever).
vision-ai.uz {
	redir https://{$DOMAIN}{uri} permanent
}
