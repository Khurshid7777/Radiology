# HTTPS for the CardioLens site: Caddy gets a Let's Encrypt certificate for {$DOMAIN}
# (the domain's A record must point at this server, ports 80 and 443 open).
{$DOMAIN} {
	encode gzip
	# 4 photos x 25 MB on /scans (SD-066) plus form fields.
	request_body {
		max_size 110MB
	}
	reverse_proxy cardiolens:8000
}

# D352: the landing page vision-ai.uz lives on this server (the owner, 25.11; D341 cancelled). Static files only, from the
# host folder LANDING_DIR (deploy/target.env), mounted read-only at /srv/landing; the files are not in git.
vision-ai.uz {
	encode gzip
	root * /srv/landing
	file_server
}

www.vision-ai.uz {
	redir https://vision-ai.uz{uri} permanent
}
