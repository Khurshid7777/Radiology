# Where the Deploy workflow puts CardioLens (D153). Not secret: the domain's DNS record
# shows the IP to anyone. The only secret is the SSH key (GitHub secret SERVER_SSH_KEY).
DOMAIN=cardio.vision-ai.uz
SERVER_HOST=149.202.70.147
SERVER_USER=ubuntu
# D310: SSH password login off — only with the owner's consent (a user who logs in by password would be locked out).
HARDEN_SSH_PASSWORD_OFF=yes   # owner, 18.11: logs in with a key (passphrase), not a server password
