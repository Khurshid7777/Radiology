# deploy/.env on the server — written by .github/workflows/deploy.yml from GitHub secrets.
# Kept here only as a list of what the server needs; never commit real values.
DOMAIN=ecg.example.uz
# API keys for /api and /scans: "name:key,name2:key2" (the web page asks for one).
ECGSCAN_API_KEYS=clinic:change-me
# Fernet key for keeping scan originals encrypted 30 days (empty: originals not kept):
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ECGSCAN_STORAGE_KEY=
# Anthropic API key for the narrative text (empty: offline template).
ANTHROPIC_API_KEY=
CARDIOLENS_LLM_PROVIDER=auto
